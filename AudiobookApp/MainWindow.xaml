<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AudiobookApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudiobookApp"
        xmlns:views="using:AudiobookApp.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AudiobookApp">

    <Grid RowDefinitions="*,Auto">
        <NavigationView x:Name="RootNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False">

            <NavigationView.PaneCustomContent>
                <StackPanel Spacing="4" Padding="0,4,0,8">
                    <Button x:Name="FullLibraryButton"
                            Click="FullLibrary_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Library"/>
                            <TextBlock Text="Full Library"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AudiobooksButton"
                            Click="Audiobooks_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                            <TextBlock Text="Audiobooks"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="EpubsButton"
                            Click="Epubs_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                            <TextBlock Text="Epubs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <StackPanel Spacing="4" Padding="0,0,0,8">
                    <Button x:Name="HelpButton"
                            Click="Help_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Help"/>
                            <TextBlock Text="Help"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearLibraryButton"
                            Click="ClearLibrary_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Delete"/>
                            <TextBlock Text="Clear library"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <views:MiniPlayerBar x:Name="MiniPlayer"
                             Grid.Row="1"
                             Visibility="Collapsed"/>
    </Grid>
</Window>
