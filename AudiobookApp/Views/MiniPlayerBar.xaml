<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AudiobookApp.Views.MiniPlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AudiobookApp.Views">

    <UserControl.Resources>
        <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
        <Style x:Key="MiniIconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="MiniIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="6">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
                <Border Width="44"
                        Height="44"
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon x:Name="CoverPlaceholder"
                                  Glyph="&#xE8D6;"
                                  FontSize="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock x:Name="SeriesText"
                               FontSize="11"
                               Opacity="0.75"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TitleText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChapterText"
                               FontSize="12"
                               Opacity="0.75"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Center">
                    <!-- Transport -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="PreviousButton_Click"
                                ToolTipService.ToolTip="Previous chapter">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE892;" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="RewindButton_Click"
                                ToolTipService.ToolTip="Back 10 seconds">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEB9E;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTipService.ToolTip="Play / Pause">
                            <FontIcon x:Name="PlayPauseIcon"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE768;"
                                      FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="FastForwardButton_Click"
                                ToolTipService.ToolTip="Forward 10 seconds">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEB9D;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="NextButton_Click"
                                ToolTipService.ToolTip="Next chapter">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE893;" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1"
                            Margin="8,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Stretch"/>

                    <!-- Volume / speed / sleep / autoplay -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="VolumeButton"
                                Style="{StaticResource MiniIconButtonStyle}"
                                Click="VolumeButton_Click"
                                ToolTipService.ToolTip="Volume">
                            <Button.Flyout>
                                <Flyout Placement="Top"
                                        ShouldConstrainToRootBounds="False">
                                    <StackPanel Spacing="8" Padding="8" MinWidth="64">
                                        <TextBlock x:Name="VolumeFlyoutValueText"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <Slider x:Name="VolumeSlider"
                                                Orientation="Vertical"
                                                Height="140"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                IsThumbToolTipEnabled="False"
                                                HorizontalAlignment="Center"
                                                ValueChanged="VolumeSlider_ValueChanged"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon x:Name="VolumeIcon"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE767;"
                                      FontSize="14"/>
                        </Button>

                        <Button x:Name="SpeedButton"
                                Style="{StaticResource MiniIconButtonStyle}"
                                Click="SpeedButton_Click"
                                ToolTipService.ToolTip="Playback speed">
                            <Button.Flyout>
                                <Flyout Placement="Top"
                                        ShouldConstrainToRootBounds="False">
                                    <StackPanel Spacing="8" Padding="8" MinWidth="64">
                                        <TextBlock x:Name="SpeedFlyoutValueText"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <Slider x:Name="SpeedSlider"
                                                Orientation="Vertical"
                                                Height="140"
                                                Minimum="0.5"
                                                Maximum="4.0"
                                                StepFrequency="0.05"
                                                IsThumbToolTipEnabled="False"
                                                HorizontalAlignment="Center"
                                                ValueChanged="SpeedSlider_ValueChanged"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEC4A;" FontSize="14"/>
                        </Button>

                        <Button x:Name="SleepButton"
                                Style="{StaticResource MiniIconButtonStyle}"
                                Click="SleepButton_Click"
                                ToolTipService.ToolTip="Sleep timer">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="5 minutes" Click="SleepPreset_Click" Tag="5"/>
                                    <MenuFlyoutItem Text="10 minutes" Click="SleepPreset_Click" Tag="10"/>
                                    <MenuFlyoutItem Text="15 minutes" Click="SleepPreset_Click" Tag="15"/>
                                    <MenuFlyoutItem Text="30 minutes" Click="SleepPreset_Click" Tag="30"/>
                                    <MenuFlyoutItem Text="45 minutes" Click="SleepPreset_Click" Tag="45"/>
                                    <MenuFlyoutItem Text="60 minutes" Click="SleepPreset_Click" Tag="60"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="End of chapter" Click="SleepEndChapter_Click"/>
                                    <MenuFlyoutItem Text="Custom…" Click="SleepCustom_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Cancel timer" Click="SleepCancel_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE708;" FontSize="14"/>
                        </Button>

                        <ToggleButton x:Name="AutoplayButton"
                                      Style="{StaticResource MiniIconToggleStyle}"
                                      Click="AutoplayButton_Click"
                                      ToolTipService.ToolTip="Series autoplay"
                                      Visibility="Collapsed">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8EE;" FontSize="14"/>
                        </ToggleButton>
                    </StackPanel>

                    <Border Width="1"
                            Margin="8,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Stretch"/>

                    <!-- Expand / collapse / close -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="ExpandButton_Click"
                                ToolTipService.ToolTip="Open full player">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE740;" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="CollapseButton_Click"
                                ToolTipService.ToolTip="Collapse to floating mini player">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEA60;" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTipService.ToolTip="Close mini player">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <TextBlock x:Name="CurrentTimeText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="00:00"/>
                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        ValueChanged="ProgressSlider_ValueChanged"
                        PointerPressed="ProgressSlider_PointerPressed"
                        PointerReleased="ProgressSlider_PointerReleased"
                        PointerCaptureLost="ProgressSlider_PointerReleased"
                        ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"/>
                <TextBlock x:Name="TotalTimeText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="00:00"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
