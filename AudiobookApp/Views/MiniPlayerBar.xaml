<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AudiobookApp.Views.MiniPlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AudiobookApp.Views">

    <UserControl.Resources>
        <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="6">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
                <Border Width="44"
                        Height="44"
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon x:Name="CoverPlaceholder"
                                  Glyph="&#xE8D6;"
                                  FontSize="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock x:Name="TitleText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChapterText"
                               FontSize="12"
                               Opacity="0.75"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Click="PreviousButton_Click" Padding="8,4">
                        <SymbolIcon Symbol="Previous"/>
                    </Button>
                    <Button Click="RewindButton_Click" Padding="8,4" Content="-10s"/>
                    <Button Click="PlayPauseButton_Click" Padding="10,4">
                        <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play"/>
                    </Button>
                    <Button Click="FastForwardButton_Click" Padding="8,4" Content="+10s"/>
                    <Button Click="NextButton_Click" Padding="8,4">
                        <SymbolIcon Symbol="Next"/>
                    </Button>
                    <Button Content="Expand" Click="ExpandButton_Click" Padding="10,4"/>
                    <Button Click="CloseButton_Click" Padding="8,4" ToolTipService.ToolTip="Close mini player">
                        <SymbolIcon Symbol="Cancel"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <TextBlock x:Name="CurrentTimeText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="00:00"/>
                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        ValueChanged="ProgressSlider_ValueChanged"
                        PointerPressed="ProgressSlider_PointerPressed"
                        PointerReleased="ProgressSlider_PointerReleased"
                        PointerCaptureLost="ProgressSlider_PointerReleased"
                        ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"/>
                <TextBlock x:Name="TotalTimeText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="00:00"/>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,Auto,*,Auto,*,Auto"
                  ColumnSpacing="8">
                <TextBlock Text="Speed"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <ComboBox x:Name="PlaybackSpeedBox"
                          Grid.Column="1"
                          Width="78"
                          SelectionChanged="PlaybackSpeedBox_SelectionChanged">
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="0.75x"/>
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="1.75x"/>
                    <ComboBoxItem Content="2.0x"/>
                    <ComboBoxItem Content="2.5x"/>
                    <ComboBoxItem Content="3.0x"/>
                    <ComboBoxItem Content="3.5x"/>
                    <ComboBoxItem Content="4.0x"/>
                </ComboBox>

                <FontIcon Grid.Column="3"
                          Glyph="&#xE767;"
                          FontSize="14"
                          VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider"
                        Grid.Column="4"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        StepFrequency="1"
                        ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="VolumeValueText"
                           Grid.Column="5"
                           Text="100"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="24"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
