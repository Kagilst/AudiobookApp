<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.DirectoryImportReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Review directory import"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText"
                       Opacity="0.75"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Select all" Click="SelectAll_Click"/>
                <Button Content="Select none" Click="SelectNone_Click"/>
                <Button Content="Remove selected" Click="RemoveSelected_Click"/>
                <Button Content="Merge selected" Click="MergeSelected_Click"/>
                <Button Content="Split selected" Click="SplitSelected_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <ToggleButton x:Name="MergedFilterButton"
                              Content="Merged audio only"
                              Click="Filter_Click"/>
                <ToggleButton x:Name="SingularFilterButton"
                              Content="Singular audio only"
                              Click="Filter_Click"/>
                <ToggleButton x:Name="EpubFilterButton"
                              Content="Epubs only"
                              Click="Filter_Click"/>
            </StackPanel>
        </Grid>

        <ListView x:Name="CandidatesList"
                  Grid.Row="2"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  MinWidth="32"/>

                        <Border Grid.Column="1"
                                Width="56"
                                Height="56"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="20"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                            <TextBox Text="{Binding Title, Mode=TwoWay}"
                                     Header="Title"
                                     MinWidth="220"/>
                            <TextBox Text="{Binding Author, Mode=TwoWay}"
                                     Header="Author"
                                     MinWidth="220"/>
                            <TextBlock Opacity="0.65" FontSize="12">
                                <Run Text="{Binding FileSummary}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding ReasonLabel}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="Files"
                                Click="ViewFiles_Click"
                                VerticalAlignment="Center"
                                Tag="{Binding}"/>

                        <Button Grid.Column="4"
                                Content="Remove"
                                Click="RemoveCandidate_Click"
                                VerticalAlignment="Center"
                                Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock x:Name="SelectionStatusText"
                       VerticalAlignment="Center"
                       Opacity="0.7"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="110"/>
            <Button Grid.Column="2"
                    x:Name="ImportButton"
                    Content="Import selected"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Import_Click"
                    MinWidth="140"/>
        </Grid>
    </Grid>
</Page>
