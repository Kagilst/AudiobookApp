<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.MultiFileSortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40" RowDefinitions="Auto,*,Auto" RowSpacing="16" MaxWidth="640" HorizontalAlignment="Center">
        <StackPanel Spacing="6">
            <TextBlock Text="Arrange file order"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Files play from top to bottom. Drag tracks to reorder, or use Move up / Move down, then continue."
                       Opacity="0.7"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ListView x:Name="FilesList"
                      SelectionMode="Single"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      SelectionChanged="FilesList_SelectionChanged"
                      DragItemsCompleted="FilesList_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IndexDisplay}"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding FileName}"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{Binding Directory}"
                                           Opacity="0.55"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Top"
                        MinWidth="120">
                <Button x:Name="MoveUpButton"
                        Content="Move up"
                        Click="MoveUp_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
                <Button x:Name="MoveDownButton"
                        Content="Move down"
                        Click="MoveDown_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1"
                    Content="Continue"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Continue_Click"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Page>
