<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.EpubReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootPage"
    Background="#E8DFD0">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center" Spacing="4" MaxWidth="680">
                <TextBlock x:Name="BookTitleText"
                           FontFamily="Georgia"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#3B2F2F"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <TextBlock x:Name="ChapterTitleText"
                           FontFamily="Georgia"
                           FontSize="15"
                           FontStyle="Italic"
                           Foreground="#6B5A4E"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <Button x:Name="DarkModeButton"
                    Content="Dark mode"
                    Click="DarkModeButton_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="14,8"
                    Background="#6B5344"
                    Foreground="#FBF6EB"
                    BorderBrush="#4E3C31"
                    BorderThickness="1"/>
        </Grid>

        <!-- Book page -->
        <Border x:Name="BookPageBorder"
                Grid.Row="1"
                MaxWidth="820"
                HorizontalAlignment="Center"
                Background="#FBF6EB"
                BorderBrush="#C9B79A"
                BorderThickness="1"
                CornerRadius="2"
                Margin="8,0">
            <Grid>
                <ScrollViewer x:Name="PageScroller"
                              Padding="48,40,48,56"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <RichTextBlock x:Name="PageText"
                                   FontFamily="Georgia"
                                   FontSize="18"
                                   LineHeight="32"
                                   Foreground="#2C2420"
                                   TextWrapping="WrapWholeWords"
                                   IsTextSelectionEnabled="True"/>
                </ScrollViewer>

                <ProgressRing x:Name="LoadingRing"
                              IsActive="True"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,16,0,0"
              MaxWidth="820"
              HorizontalAlignment="Center"
              ColumnSpacing="48"
              ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="PreviousChapterButton"
                    Content="Previous"
                    Click="PreviousChapter_Click"
                    Padding="16,8"
                    MinWidth="110"
                    Background="#6B5344"
                    Foreground="#FBF6EB"
                    BorderBrush="#4E3C31"
                    BorderThickness="1"/>

            <TextBlock x:Name="ProgressText"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="24,0"
                       FontFamily="Georgia"
                       Foreground="#6B5A4E"/>

            <Button x:Name="NextChapterButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="NextChapter_Click"
                    Padding="16,8"
                    MinWidth="110"
                    Background="#6B5344"
                    Foreground="#FBF6EB"
                    BorderBrush="#4E3C31"
                    BorderThickness="1"/>
        </Grid>
    </Grid>
</Page>
