<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.EpubReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,*,Auto">

        <!-- Top: title + display / theme (right) -->
        <Grid Grid.Column="1"
              Margin="0,0,0,16"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <StackPanel HorizontalAlignment="Center"
                        Spacing="4"
                        MaxWidth="680"
                        VerticalAlignment="Center">
                <TextBlock x:Name="BookTitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <TextBlock x:Name="ChapterTitleText"
                           FontSize="15"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="10,8"
                    ToolTipService.ToolTip="Settings">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE713;"
                          FontSize="16"/>
                <Button.Flyout>
                    <Flyout x:Name="SettingsFlyout" Placement="Bottom">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="300" Spacing="14" Padding="4">
                                <TextBlock Text="Appearance"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <Button x:Name="DarkModeButton"
                                        Content="Dark mode"
                                        Click="DarkModeButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="12,8"/>

                                <TextBlock Text="Text"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Text size" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Button x:Name="FontSizeMinusButton"
                                            Content="−"
                                            Width="40"
                                            Click="FontSizeMinusButton_Click"/>
                                    <TextBlock x:Name="FontSizeLabel"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <Button x:Name="FontSizePlusButton"
                                            Grid.Column="2"
                                            Content="+"
                                            Width="40"
                                            Click="FontSizePlusButton_Click"/>
                                </Grid>

                                <TextBlock Text="Font" FontWeight="SemiBold"/>
                                <ComboBox x:Name="FontFamilyCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="FontFamilyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Serif" Tag="serif"/>
                                    <ComboBoxItem Content="Sans" Tag="sans"/>
                                </ComboBox>

                                <TextBlock Text="Line spacing" FontWeight="SemiBold"/>
                                <ComboBox x:Name="LineSpacingCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="LineSpacingCombo_SelectionChanged">
                                    <ComboBoxItem Content="Tight" Tag="tight"/>
                                    <ComboBoxItem Content="Normal" Tag="normal"/>
                                    <ComboBoxItem Content="Relaxed" Tag="relaxed"/>
                                </ComboBox>

                                <TextBlock Text="Page width" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ContentWidthCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ContentWidthCombo_SelectionChanged">
                                    <ComboBoxItem Content="Narrow" Tag="narrow"/>
                                    <ComboBoxItem Content="Medium" Tag="medium"/>
                                    <ComboBoxItem Content="Wide" Tag="wide"/>
                                </ComboBox>

                                <TextBlock Text="Text to speech"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Voice" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TtsVoiceCombo"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Voice"
                                          SelectionChanged="TtsVoiceCombo_SelectionChanged"/>

                                <TextBlock Text="Volume" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider x:Name="TtsVolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="1"
                                            Value="100"
                                            IsThumbToolTipEnabled="False"
                                            ValueChanged="TtsVolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="TtsVolumeValueText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               MinWidth="36"
                                               Text="100%"/>
                                </Grid>

                                <TextBlock Text="Speed" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider x:Name="TtsSpeedSlider"
                                            Minimum="0.5"
                                            Maximum="2.0"
                                            StepFrequency="0.1"
                                            Value="1.0"
                                            IsThumbToolTipEnabled="False"
                                            ValueChanged="TtsSpeedSlider_ValueChanged"/>
                                    <TextBlock x:Name="TtsSpeedValueText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               MinWidth="40"
                                               Text="1.0×"/>
                                </Grid>

                                <TextBlock Text="Sleep timer" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TtsSleepCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="TtsSleepCombo_SelectionChanged">
                                    <ComboBoxItem Content="Off" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="5 minutes" Tag="5"/>
                                    <ComboBoxItem Content="10 minutes" Tag="10"/>
                                    <ComboBoxItem Content="15 minutes" Tag="15"/>
                                    <ComboBoxItem Content="30 minutes" Tag="30"/>
                                    <ComboBoxItem Content="45 minutes" Tag="45"/>
                                    <ComboBoxItem Content="60 minutes" Tag="60"/>
                                </ComboBox>
                                <TextBlock x:Name="TtsSleepStatusText"
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords"
                                           Text=""/>

                                <Button x:Name="TtsStopButton"
                                        Content="Stop listening"
                                        HorizontalAlignment="Stretch"
                                        Click="TtsStopButton_Click"/>
                                <TextBlock x:Name="TtsStatusText"
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords"
                                           Text="Stopped"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Left vertical toolbar -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch"
                      Width="132">
            <StackPanel Spacing="8" Padding="0,0,4,0">
                <Button x:Name="TocButton"
                        Content="Contents"
                        Click="TocButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10">
                    <Button.Flyout>
                        <Flyout x:Name="TocFlyout" Placement="Right">
                            <ListView x:Name="TocList"
                                      Width="320"
                                      MaxHeight="420"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="TocList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Margin="{Binding IndentMargin}"
                                                   Padding="4,8"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="BookmarkButton"
                        Content="Bookmarks"
                        Click="BookmarkButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10">
                    <Button.Flyout>
                        <Flyout x:Name="BookmarkFlyout" Placement="Right">
                            <StackPanel Width="340" Spacing="10" Padding="4">
                                <Button x:Name="AddBookmarkButton"
                                        Content="Add bookmark here"
                                        HorizontalAlignment="Stretch"
                                        Click="AddBookmarkButton_Click"/>
                                <TextBlock x:Name="BookmarkEmptyText"
                                           Text="No bookmarks yet."
                                           Opacity="0.7"
                                           Visibility="Collapsed"/>
                                <ListView x:Name="BookmarkList"
                                          MaxHeight="360"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="BookmarkList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="2,4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               TextWrapping="WrapWholeWords"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DetailText}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Delete"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteBookmarkButton_Click"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SearchButton"
                        Content="Search"
                        Click="SearchButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10">
                    <Button.Flyout>
                        <Flyout x:Name="SearchFlyout" Placement="Right">
                            <StackPanel Width="360" Spacing="10" Padding="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="SearchBox"
                                             PlaceholderText="Find in book"
                                             KeyDown="SearchBox_KeyDown"/>
                                    <Button x:Name="SearchGoButton"
                                            Grid.Column="1"
                                            Content="Find"
                                            Click="SearchGoButton_Click"
                                            Padding="12,6"/>
                                </Grid>
                                <TextBlock x:Name="SearchStatusText"
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords"/>
                                <ListView x:Name="SearchResultsList"
                                          MaxHeight="300"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="SearchResultsList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Padding="2,6">
                                                <TextBlock Text="{Binding ChapterLabel}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding Snippet}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="SearchPrevButton"
                                            Content="Previous"
                                            Click="SearchPrevButton_Click"
                                            IsEnabled="False"/>
                                    <Button x:Name="SearchNextButton"
                                            Grid.Column="1"
                                            Content="Next"
                                            Click="SearchNextButton_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="HighlightButton"
                        Content="Highlight"
                        Click="HighlightButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10">
                    <Button.Flyout>
                        <Flyout x:Name="HighlightFlyout" Placement="Right">
                            <StackPanel Width="360" Spacing="10" Padding="4">
                                <TextBlock Text="Highlights in this book"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Select text, then right-click to highlight or add a note."
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock x:Name="HighlightEmptyText"
                                           Text="No highlights yet."
                                           Opacity="0.7"
                                           Visibility="Collapsed"/>
                                <ListView x:Name="HighlightList"
                                          MaxHeight="360"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="HighlightList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2"
                                                        Padding="2,4"
                                                        RightTapped="HighlightListItem_RightTapped">
                                                <TextBlock Text="{Binding NoteText}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"
                                                           Visibility="{Binding NoteVisibility}"/>
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding DetailText}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="TtsButton"
                        Content="Listen"
                        Click="TtsButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Page + highlight-note gutter -->
        <Border x:Name="BookPageBorder"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0">
            <Grid>
                <ScrollViewer x:Name="PageScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="PageContentGrid"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="0">
                        <RichTextBlock x:Name="PageText"
                                       Margin="48,40,32,56"
                                       FontFamily="Georgia"
                                       FontSize="18"
                                       LineHeight="32"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True"
                                       SizeChanged="PageText_SizeChanged">
                            <RichTextBlock.ContextFlyout>
                                <MenuFlyout Opening="PageTextContextFlyout_Opening">
                                    <MenuFlyoutItem Text="Look up…"
                                                    Click="ContextDefine_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutSubItem Text="Highlight">
                                        <MenuFlyoutItem Text="Yellow" Tag="Yellow" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Green" Tag="Green" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Blue" Tag="Blue" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Pink" Tag="Pink" Click="ContextHighlightColor_Click"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Highlight + note…">
                                        <MenuFlyoutItem Text="Yellow" Tag="Yellow|note" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Green" Tag="Green|note" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Blue" Tag="Blue|note" Click="ContextHighlightColor_Click"/>
                                        <MenuFlyoutItem Text="Pink" Tag="Pink|note" Click="ContextHighlightColor_Click"/>
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </RichTextBlock.ContextFlyout>
                        </RichTextBlock>

                        <Button x:Name="CommentGutterToggleButton"
                                Grid.Column="1"
                                Content="›"
                                Width="28"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                Click="CommentGutterToggleButton_Click"
                                ToolTipService.ToolTip="Hide notes"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="0"/>

                        <Border x:Name="CommentGutterHost"
                                Grid.Column="2"
                                Width="260"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Padding="10,40,10,56">
                            <Canvas x:Name="CommentGutter"
                                    HorizontalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ProgressRing x:Name="LoadingRing"
                              IsActive="True"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="FooterNavGrid"
              Grid.Row="2"
              Grid.Column="1"
              Margin="0,16,0,0"
              HorizontalAlignment="Center"
              ColumnSpacing="16"
              ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="PreviousChapterButton"
                    Content="Previous"
                    Click="PreviousChapter_Click"
                    Padding="16,8"
                    MinWidth="110"/>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                <ComboBox x:Name="ChapterCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ChapterCombo_SelectionChanged"/>
                <TextBlock x:Name="ProgressText"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Opacity="0.7"
                           TextWrapping="WrapWholeWords"
                           TextAlignment="Center"/>
            </StackPanel>

            <Button x:Name="NextChapterButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="NextChapter_Click"
                    Padding="16,8"
                    MinWidth="110"/>
        </Grid>
    </Grid>
</Page>
