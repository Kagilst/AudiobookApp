<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.EpubReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="TocButton"
                        Content="Contents"
                        Click="TocButton_Click"
                        Padding="14,8">
                    <Button.Flyout>
                        <Flyout x:Name="TocFlyout" Placement="Bottom">
                            <ListView x:Name="TocList"
                                      Width="320"
                                      MaxHeight="420"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="TocList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Margin="{Binding IndentMargin}"
                                                   Padding="4,8"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="BookmarkButton"
                        Content="Bookmarks"
                        Click="BookmarkButton_Click"
                        Padding="14,8">
                    <Button.Flyout>
                        <Flyout x:Name="BookmarkFlyout" Placement="Bottom">
                            <StackPanel Width="340" Spacing="10" Padding="4">
                                <Button x:Name="AddBookmarkButton"
                                        Content="Add bookmark here"
                                        HorizontalAlignment="Stretch"
                                        Click="AddBookmarkButton_Click"/>
                                <TextBlock x:Name="BookmarkEmptyText"
                                           Text="No bookmarks yet."
                                           Opacity="0.7"
                                           Visibility="Collapsed"/>
                                <ListView x:Name="BookmarkList"
                                          MaxHeight="360"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="BookmarkList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="2,4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               TextWrapping="WrapWholeWords"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DetailText}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Delete"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteBookmarkButton_Click"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SearchButton"
                        Content="Search"
                        Click="SearchButton_Click"
                        Padding="14,8">
                    <Button.Flyout>
                        <Flyout x:Name="SearchFlyout" Placement="Bottom">
                            <StackPanel Width="360" Spacing="10" Padding="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="SearchBox"
                                             PlaceholderText="Find in book"
                                             KeyDown="SearchBox_KeyDown"/>
                                    <Button x:Name="SearchGoButton"
                                            Grid.Column="1"
                                            Content="Find"
                                            Click="SearchGoButton_Click"
                                            Padding="12,6"/>
                                </Grid>
                                <TextBlock x:Name="SearchStatusText"
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords"/>
                                <ListView x:Name="SearchResultsList"
                                          MaxHeight="300"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="SearchResultsList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Padding="2,6">
                                                <TextBlock Text="{Binding ChapterLabel}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding Snippet}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="SearchPrevButton"
                                            Content="Previous"
                                            Click="SearchPrevButton_Click"
                                            IsEnabled="False"/>
                                    <Button x:Name="SearchNextButton"
                                            Grid.Column="1"
                                            Content="Next"
                                            Click="SearchNextButton_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        MaxWidth="680">
                <TextBlock x:Name="BookTitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <TextBlock x:Name="ChapterTitleText"
                           FontSize="15"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="DisplayButton"
                        Content="Aa"
                        VerticalAlignment="Top"
                        Padding="14,8">
                    <Button.Flyout>
                        <Flyout x:Name="DisplayFlyout" Placement="Bottom">
                            <StackPanel Width="280" Spacing="14" Padding="4">
                                <TextBlock Text="Text size"
                                           FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Button x:Name="FontSizeMinusButton"
                                            Content="−"
                                            Width="40"
                                            Click="FontSizeMinusButton_Click"/>
                                    <TextBlock x:Name="FontSizeLabel"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <Button x:Name="FontSizePlusButton"
                                            Grid.Column="2"
                                            Content="+"
                                            Width="40"
                                            Click="FontSizePlusButton_Click"/>
                                </Grid>

                                <TextBlock Text="Font"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="FontFamilyCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="FontFamilyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Serif" Tag="serif"/>
                                    <ComboBoxItem Content="Sans" Tag="sans"/>
                                </ComboBox>

                                <TextBlock Text="Line spacing"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="LineSpacingCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="LineSpacingCombo_SelectionChanged">
                                    <ComboBoxItem Content="Tight" Tag="tight"/>
                                    <ComboBoxItem Content="Normal" Tag="normal"/>
                                    <ComboBoxItem Content="Relaxed" Tag="relaxed"/>
                                </ComboBox>

                                <TextBlock Text="Page width"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="ContentWidthCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ContentWidthCombo_SelectionChanged">
                                    <ComboBoxItem Content="Narrow" Tag="narrow"/>
                                    <ComboBoxItem Content="Medium" Tag="medium"/>
                                    <ComboBoxItem Content="Wide" Tag="wide"/>
                                </ComboBox>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="DarkModeButton"
                        Content="Dark mode"
                        Click="DarkModeButton_Click"
                        VerticalAlignment="Top"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <Border x:Name="BookPageBorder"
                Grid.Row="1"
                MaxWidth="820"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="8,0">
            <Grid>
                <ScrollViewer x:Name="PageScroller"
                              Padding="48,40,48,56"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <RichTextBlock x:Name="PageText"
                                   FontFamily="Georgia"
                                   FontSize="18"
                                   LineHeight="32"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   IsTextSelectionEnabled="True"/>
                </ScrollViewer>

                <ProgressRing x:Name="LoadingRing"
                              IsActive="True"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="FooterNavGrid"
              Grid.Row="2"
              Margin="0,16,0,0"
              MaxWidth="820"
              HorizontalAlignment="Center"
              ColumnSpacing="16"
              ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="PreviousChapterButton"
                    Content="Previous"
                    Click="PreviousChapter_Click"
                    Padding="16,8"
                    MinWidth="110"/>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                <ComboBox x:Name="ChapterCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ChapterCombo_SelectionChanged"/>
                <TextBlock x:Name="ProgressText"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Opacity="0.7"
                           TextWrapping="WrapWholeWords"
                           TextAlignment="Center"/>
            </StackPanel>

            <Button x:Name="NextChapterButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="NextChapter_Click"
                    Padding="16,8"
                    MinWidth="110"/>
        </Grid>
    </Grid>
</Page>
