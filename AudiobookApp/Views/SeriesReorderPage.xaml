<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.SeriesReorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40" RowDefinitions="Auto,*,Auto" RowSpacing="16" MaxWidth="720" HorizontalAlignment="Center">
        <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText"
                       Text="Reorder series"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Books appear in this order in the series. Drag to reorder, or use Move up / Move down, then continue."
                       Opacity="0.7"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ListView x:Name="BooksList"
                      SelectionMode="Single"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      SelectionChanged="BooksList_SelectionChanged"
                      DragItemsCompleted="BooksList_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IndexDisplay}"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D6;"
                                              FontSize="18"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <Image Source="{Binding CoverImage}"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{Binding Author}"
                                           Opacity="0.55"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Top"
                        MinWidth="140">
                <Button x:Name="MoveUpButton"
                        Content="Move up"
                        Click="MoveUp_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
                <Button x:Name="MoveDownButton"
                        Content="Move down"
                        Click="MoveDown_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
                <Button x:Name="RemoveButton"
                        Content="Remove from series"
                        Click="Remove_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    HorizontalAlignment="Stretch"/>
            <Button x:Name="SaveButton"
                    Grid.Column="1"
                    Content="Continue"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Save_Click"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Page>
