<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.ComicReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowDefinitions="Auto,*,Auto">
        <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel HorizontalAlignment="Center"
                        Spacing="4"
                        MaxWidth="720"
                        VerticalAlignment="Center">
                <TextBlock x:Name="BookTitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <TextBlock x:Name="PageStatusText"
                           FontSize="14"
                           Opacity="0.7"
                           TextAlignment="Center"/>
            </StackPanel>

            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="10,8"
                    ToolTipService.ToolTip="Settings">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE713;"
                          FontSize="16"/>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="280" Spacing="12" Padding="4">
                            <TextBlock Text="Reading mode"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>
                            <ComboBox x:Name="ReadingModeCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ReadingModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Left to right" Tag="LeftToRight"/>
                                <ComboBoxItem Content="Right to left" Tag="RightToLeft"/>
                                <ComboBoxItem Content="Top to bottom" Tag="VerticalStrip"/>
                            </ComboBox>

                            <TextBlock Text="Page width"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,4,0,0"/>
                            <ComboBox x:Name="PageWidthCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="PageWidthCombo_SelectionChanged">
                                <ComboBoxItem Content="Thin" Tag="thin"/>
                                <ComboBoxItem Content="Normal" Tag="normal"/>
                                <ComboBoxItem Content="Wide" Tag="wide"/>
                            </ComboBox>

                            <TextBlock Text="Zoom"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button x:Name="ZoomMinusButton"
                                        Content="−"
                                        Width="40"
                                        Click="ZoomMinusButton_Click"/>
                                <TextBlock x:Name="ZoomLabel"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="ZoomPlusButton"
                                        Grid.Column="2"
                                        Content="+"
                                        Width="40"
                                        Click="ZoomPlusButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" x:Name="ReaderHost">
            <ProgressRing x:Name="LoadingRing"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True"/>

            <!-- Page mode: single image -->
            <Grid x:Name="PageModeHost" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <ScrollViewer x:Name="PageScroller"
                                  ZoomMode="Enabled"
                                  MinZoomFactor="0.5"
                                  MaxZoomFactor="4"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Auto">
                        <Image x:Name="PageImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Strip mode: stacked pages -->
            <ScrollViewer x:Name="StripScroller"
                          Visibility="Collapsed"
                          ZoomMode="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="StripScroller_ViewChanged">
                <StackPanel x:Name="StripPanel"
                            Spacing="0"
                            HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,16,0,0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Button x:Name="PreviousPageButton"
                    Content="Previous"
                    Click="PreviousPageButton_Click"
                    Padding="16,8"
                    MinWidth="100"/>
            <TextBlock x:Name="FooterStatusText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Opacity="0.75"/>
            <Button x:Name="NextPageButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="NextPageButton_Click"
                    Padding="16,8"
                    MinWidth="100"/>
        </Grid>
    </Grid>
</Page>
