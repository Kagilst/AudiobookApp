<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Help"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Expand a section to learn what a feature does and where to find it in the app."
                       Opacity="0.75"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="False"
                                  Margin="0,0,0,12"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Header="{Binding Title}">
                            <StackPanel Spacing="12" Padding="4,12,4,4" MaxWidth="720">
                                <TextBlock Text="{Binding Body}"
                                           TextWrapping="WrapWholeWords"
                                           LineHeight="22"/>

                                <ItemsControl ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="8" Margin="0,0,0,8">
                                                <Border CornerRadius="8"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        MaxWidth="640"
                                                        HorizontalAlignment="Left">
                                                    <Grid MinHeight="120">
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="4"
                                                                    Margin="16"
                                                                    Visibility="{Binding PlaceholderVisibility}">
                                                            <FontIcon Glyph="&#xE91B;"
                                                                      FontSize="28"
                                                                      Opacity="0.45"
                                                                      HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding PlaceholderText}"
                                                                       Opacity="0.55"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="WrapWholeWords"/>
                                                        </StackPanel>
                                                        <Image Source="{Binding ImageSource}"
                                                               Stretch="Uniform"
                                                               MaxWidth="640"
                                                               Visibility="{Binding ImageVisibility}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Caption}"
                                                           Opacity="0.65"
                                                           FontSize="12"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxWidth="640"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
