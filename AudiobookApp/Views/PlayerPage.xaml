<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AudiobookApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >

    <Page.Resources>
        <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
    </Page.Resources>

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="10">

        <Border Width="180"
        Height="180"
        CornerRadius="8"
        HorizontalAlignment="Center"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
            <Grid>
                <Image x:Name="CoverImage"
               Stretch="UniformToFill"/>
                <FontIcon x:Name="CoverPlaceholder"
                  Glyph="&#xE8D6;"
                  FontSize="48"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TextBlock
            x:Name="TitleText"
            FontSize="18"
            FontWeight="SemiBold"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords"
            HorizontalAlignment="Center"/>

        <TextBlock
            x:Name="AuthorText"
            FontSize="14"
            Opacity="0.7"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords"
            HorizontalAlignment="Center"/>

        <TextBlock
            x:Name="ChapterText"
            FontSize="14"
            FontWeight="SemiBold"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords"
            HorizontalAlignment="Center"
            Visibility="Collapsed"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="20">

            <Button x:Name="PreviousButton"
                    Click="PreviousButton_Click">
                <SymbolIcon Symbol="Previous"/>
            </Button>

            <Button x:Name="RewindButton"
                    MinWidth="56"
                    Click="RewindButton_Click"
                    ToolTipService.ToolTip="Skip back 10 seconds">
                <TextBlock Text="-10s"
                           FontWeight="SemiBold"/>
            </Button>

            <Button
    x:Name="PlayPauseButton"
    Width="64"
    Height="64"
    Click="PlayPauseButton_Click">

                <SymbolIcon
        x:Name="PlayPauseIcon"
        Symbol="Play"/>
            </Button>

            <Button x:Name="FastForwardButton"
                    MinWidth="56"
                    Click="FastForwardButton_Click"
                    ToolTipService.ToolTip="Skip forward 10 seconds">
                <TextBlock Text="+10s"
                           FontWeight="SemiBold"/>
            </Button>

            <Button x:Name="NextButton"
                    Click="NextButton_Click">
                <SymbolIcon Symbol="Next"/>
            </Button>

        </StackPanel>

        <StackPanel
            Width="500"
            HorizontalAlignment="Center"
            Spacing="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
            x:Name="CurrentTimeText"
            VerticalAlignment="Center"
            Text="00:00:00"/>

                <Slider
                x:Name="ProgressSlider"
                Grid.Column="1"
                Margin="10,0"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"

                ValueChanged="ProgressSlider_ValueChanged"

                PointerPressed="ProgressSlider_PointerPressed"
                PointerReleased="ProgressSlider_PointerReleased"
                PointerCaptureLost="ProgressSlider_PointerReleased"

                ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"/>
                

                <TextBlock
            x:Name="TotalTimeText"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text="00:00:00"/>
            </Grid>

        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10">

            <TextBlock Text="Speed"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="PlaybackSpeedBox"
                      Width="90"
                      SelectionChanged="PlaybackSpeedBox_SelectionChanged">

                <ComboBoxItem Content="0.5x"/>
                <ComboBoxItem Content="0.75x"/>
                <ComboBoxItem Content="1.0x"/>
                <ComboBoxItem Content="1.25x"/>
                <ComboBoxItem Content="1.5x"/>
                <ComboBoxItem Content="1.75x"/>
                <ComboBoxItem Content="2.0x"/>
                <ComboBoxItem Content="2.5x"/>
                <ComboBoxItem Content="3.0x"/>
                <ComboBoxItem Content="3.5x"/>
                <ComboBoxItem Content="4.0x"/>

            </ComboBox>

        </StackPanel>

        <Grid Width="500"
              ColumnSpacing="12"
              ColumnDefinitions="Auto,*,Auto">
            <FontIcon Glyph="&#xE767;"
                      FontSize="16"
                      VerticalAlignment="Center"/>

            <Slider x:Name="VolumeSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    StepFrequency="1"
                    TickFrequency="10"
                    IsThumbToolTipEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <TextBlock x:Name="VolumeValueText"
                       Grid.Column="2"
                       Text="100"
                       MinWidth="28"
                       VerticalAlignment="Center"
                       TextAlignment="Right"/>
        </Grid>

    </StackPanel>
</Page>
