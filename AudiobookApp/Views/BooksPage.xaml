<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.BooksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AudiobookApp.Views">

    <Page.Resources>
        <DataTemplate x:Key="SeriesMemberTemplate">
            <Grid Padding="8">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Rate"
                                        Click="SeriesMemberRate_Click"/>
                        <MenuFlyoutItem Text="Edit"
                                        Click="SeriesMemberEdit_Click"/>
                        <MenuFlyoutItem Text="Add tags"
                                        Click="SeriesMemberAddTags_Click"/>
                        <MenuFlyoutItem Text="Remove from series"
                                        Click="SeriesMemberRemove_Click"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid ColumnDefinitions="48,*,Auto,Auto"
                      ColumnSpacing="12">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Author}"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>
                        <local:StarRatingControl Rating="{Binding RatingValue}"
                                                 StarSize="12"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ProgressText}"
                               VerticalAlignment="Center"
                               Opacity="0.7"/>

                    <Button Grid.Column="3"
                            Content="Remove"
                            Click="SeriesMemberRemove_Click"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Remove from series or library"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BookListTemplate">
            <Border Padding="10"
                    CornerRadius="6"
                    BorderThickness="{Binding SeriesSelectBorderThickness}"
                    BorderBrush="{Binding SeriesSelectBorderBrush}"
                    Background="{Binding SeriesSelectBackground}">
                <Border.ContextFlyout>
                    <MenuFlyout Opening="ItemContextFlyout_Opening">
                        <MenuFlyoutItem Text="Rate"
                                        Click="RateBook_Click"
                                        Tag="Rate"/>
                        <MenuFlyoutItem Text="Edit"
                                        Click="EditBook_Click"
                                        Tag="EditBook"/>
                        <MenuFlyoutItem Text="Add tags"
                                        Click="AddTags_Click"/>
                        <MenuFlyoutItem Text="Add to series..."
                                        Click="AddToSeries_Click"
                                        Tag="AddToSeries"/>
                        <MenuFlyoutItem Text="Create series..."
                                        Click="CreateSeries_Click"
                                        Tag="CreateSeries"/>
                        <MenuFlyoutItem Text="Remove from series"
                                        Click="RemoveFromSeries_Click"
                                        Tag="RemoveFromSeries"/>
                        <MenuFlyoutItem Text="Reorder series..."
                                        Click="ReorderSeries_Click"
                                        Tag="ReorderSeries"/>
                        <MenuFlyoutItem Text="Rename series"
                                        Click="RenameSeries_Click"
                                        Tag="RenameSeries"/>
                        <MenuFlyoutItem Text="Disband series"
                                        Click="DisbandSeries_Click"
                                        Tag="DisbandSeries"/>
                        <MenuFlyoutItem Text="Remove"
                                        Click="RemoveBook_Click"
                                        Tag="RemoveBook"/>
                    </MenuFlyout>
                </Border.ContextFlyout>

                <Grid ColumnDefinitions="72,*"
                      ColumnSpacing="14"
                      MinHeight="64">
                    <Grid Width="56" Height="56">
                        <!-- Series stacked covers -->
                        <Border Width="44"
                                Height="44"
                                CornerRadius="4"
                                Margin="10,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding StackVisibility}">
                            <Image Source="{Binding CoverImage3}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="44"
                                Height="44"
                                CornerRadius="4"
                                Margin="5,0,0,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding MidStackVisibility}">
                            <Image Source="{Binding CoverImage2}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="20"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"/>
                                <ProgressBar Value="{Binding ProgressValue}"
                                             Maximum="100"
                                             Height="4"
                                             VerticalAlignment="Bottom"
                                             Visibility="{Binding ProgressVisibility}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>
                        <local:StarRatingControl Rating="{Binding RatingValue}"
                                                 StarSize="14"
                                                 Visibility="{Binding RatingVisibility}"/>
                        <TextBlock Text="{Binding ProgressText}"
                                   Opacity="0.65"
                                   FontSize="12"
                                   Visibility="{Binding ProgressVisibility}"/>
                        <TextBlock Text="{Binding TagsDisplay}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding BookVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BookIconTemplate">
            <Border Width="168"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="{Binding SeriesSelectBorderThickness}"
                    BorderBrush="{Binding SeriesSelectBorderBrush}"
                    Background="{Binding SeriesSelectBackground}">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <StackPanel Spacing="2" MaxWidth="280">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       Opacity="0.75"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <Border.ContextFlyout>
                    <MenuFlyout Opening="ItemContextFlyout_Opening">
                        <MenuFlyoutItem Text="Rate"
                                        Click="RateBook_Click"
                                        Tag="Rate"/>
                        <MenuFlyoutItem Text="Edit"
                                        Click="EditBook_Click"
                                        Tag="EditBook"/>
                        <MenuFlyoutItem Text="Add tags"
                                        Click="AddTags_Click"
                                        Tag="AddTags"/>
                        <MenuFlyoutItem Text="Add to series..."
                                        Click="AddToSeries_Click"
                                        Tag="AddToSeries"/>
                        <MenuFlyoutItem Text="Create series..."
                                        Click="CreateSeries_Click"
                                        Tag="CreateSeries"/>
                        <MenuFlyoutItem Text="Remove from series"
                                        Click="RemoveFromSeries_Click"
                                        Tag="RemoveFromSeries"/>
                        <MenuFlyoutItem Text="Reorder series..."
                                        Click="ReorderSeries_Click"
                                        Tag="ReorderSeries"/>
                        <MenuFlyoutItem Text="Rename series"
                                        Click="RenameSeries_Click"
                                        Tag="RenameSeries"/>
                        <MenuFlyoutItem Text="Disband series"
                                        Click="DisbandSeries_Click"
                                        Tag="DisbandSeries"/>
                        <MenuFlyoutItem Text="Remove"
                                        Click="RemoveBook_Click"
                                        Tag="RemoveBook"/>
                    </MenuFlyout>
                </Border.ContextFlyout>

                <StackPanel Spacing="8">
                    <Grid Width="140"
                          Height="140"
                          HorizontalAlignment="Center">
                        <Border Width="118"
                                Height="118"
                                CornerRadius="8"
                                Margin="18,0,0,14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding StackVisibility}">
                            <Image Source="{Binding CoverImage3}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="124"
                                Height="124"
                                CornerRadius="8"
                                Margin="9,0,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding MidStackVisibility}">
                            <Image Source="{Binding CoverImage2}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="130"
                                Height="130"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="38"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"/>
                                <Grid VerticalAlignment="Bottom"
                                      Visibility="{Binding ProgressVisibility}">
                                    <Border Background="#99000000"
                                            Padding="0,10,0,0"/>
                                    <StackPanel Spacing="2"
                                                Padding="6,4,6,6"
                                                VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ProgressText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <ProgressBar Value="{Binding ProgressValue}"
                                                     Maximum="100"
                                                     Height="4"
                                                     Foreground="#F5D76E"
                                                     Background="#55FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   Opacity="0.7"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   MaxLines="2"/>
                        <local:StarRatingControl Rating="{Binding RatingValue}"
                                                 StarSize="12"
                                                 HorizontalAlignment="Center"
                                                 Visibility="{Binding RatingVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12">

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Button x:Name="ImportButton"
                    Click="ImportButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Import Book" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Grid Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  MaxWidth="520"
                  HorizontalAlignment="Stretch">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search title or author"
                         TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        MinWidth="96">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                        <TextBlock x:Name="FilterButtonText" Text="Filter"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="FilterFlyout" Placement="Bottom">
                            <StackPanel Width="240" Spacing="8">
                                <TextBlock Text="Filter"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>

                                <Button x:Name="TagFilterButton"
                                        Content="Filter by tag"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="TagFilterButton_Click">
                                    <Button.Flyout>
                                        <Flyout x:Name="TagFlyout" Placement="Right">
                                            <StackPanel Width="240" Spacing="12">
                                                <TextBlock Text="Select tags"
                                                           FontWeight="SemiBold"/>
                                                <ListView x:Name="TagFilterList"
                                                          SelectionMode="Multiple"
                                                          MaxHeight="240"
                                                          SelectionChanged="TagFilterList_SelectionChanged">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Padding="0,4"/>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <Button Content="Done"
                                                        Click="TagFlyoutDone_Click"
                                                        HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <ToggleButton x:Name="StartedFilterButton"
                                              Content="Started"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Click="ProgressFilter_Click"/>

                                <ToggleButton x:Name="NotStartedFilterButton"
                                              Content="Not started"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Click="ProgressFilter_Click"/>

                                <ToggleButton x:Name="CompletedFilterButton"
                                              Content="Completed"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Click="ProgressFilter_Click"/>

                                <ToggleButton x:Name="SeriesFilterButton"
                                              Content="Series only"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Click="LibraryTypeFilter_Click"/>

                                <ToggleButton x:Name="SinglesFilterButton"
                                              Content="Singles only"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Click="LibraryTypeFilter_Click"/>

                                <Button Content="Clear filters"
                                        Click="ClearFilters_Click"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,4,0,0"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <ToggleButton x:Name="ListViewButton"
                              Click="ListViewButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                        <TextBlock Text="List"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="IconViewButton"
                              Click="IconViewButton_Click"
                              IsChecked="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14"/>
                        <TextBlock Text="Large icons"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="ActiveFiltersText"
                       Opacity="0.7"
                       Visibility="Collapsed"/>

            <Border x:Name="SeriesSelectBar"
                    Padding="12,10"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Create series"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SeriesSelectStatusText"
                                   Opacity="0.75"
                                   TextWrapping="WrapWholeWords"
                                   Text="Click books to add them to the series."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Click="CancelSeriesSelect_Click"
                                MinWidth="100"/>
                        <Button x:Name="ConfirmSeriesSelectButton"
                                Content="Confirm"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmSeriesSelect_Click"
                                MinWidth="110"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="BooksList"
                      ItemTemplate="{StaticResource BookListTemplate}"
                      Visibility="Collapsed"
                      IsItemClickEnabled="True"
                      ItemClick="BooksList_ItemClick"/>

            <GridView x:Name="BooksGrid"
                      ItemTemplate="{StaticResource BookIconTemplate}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="BooksGrid_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="0"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </Grid>
    </Grid>
</Page>
