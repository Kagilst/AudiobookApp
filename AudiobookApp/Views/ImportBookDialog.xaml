<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.ImportBookDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="400">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Padding="40"
                        MaxWidth="420">

                <TextBlock x:Name="HeaderText"
                           Text="Import Book"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <Border Width="180"
                        Height="180"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"/>
                        <FontIcon x:Name="CoverPlaceholder"
                                  Glyph="&#xE8D6;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="AuthorText"
                           FontSize="14"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="8"
                            Width="320"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Series"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Optional. Select an option below, or click it again to clear."
                               Opacity="0.7"
                               FontSize="12"
                               TextWrapping="WrapWholeWords"/>
                    <ToggleButton x:Name="AddToSeriesToggle"
                                  Content="Add to existing series"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Click="SeriesToggle_Click"/>
                    <ToggleButton x:Name="CreateSeriesToggle"
                                  Content="Create new series"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Click="SeriesToggle_Click"/>

                    <ComboBox x:Name="ExistingSeriesCombo"
                              Header="Existing series"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"/>

                    <StackPanel x:Name="CreateSeriesPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBox x:Name="NewSeriesNameBox"
                                 Header="Series name"
                                 PlaceholderText="e.g. Astral Pet Store"/>
                        <TextBlock Text="Also add library books (optional)"
                                   Opacity="0.7"
                                   FontSize="12"
                                   TextWrapping="WrapWholeWords"/>
                        <ListView x:Name="LibraryBooksPicker"
                                  SelectionMode="Multiple"
                                  MaxHeight="160">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8"
                            Width="320"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Tags"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Select existing tags or type a new one and press Add."
                               Opacity="0.7"
                               TextWrapping="WrapWholeWords"
                               FontSize="12"/>

                    <ListView x:Name="SuggestedTagsList"
                              SelectionMode="Multiple"
                              MaxHeight="140">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="0,4"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NewTagBox"
                                 PlaceholderText="New tag (e.g. LitRPG, Fiction)"/>
                        <Button Grid.Column="1"
                                Content="Add"
                                Click="AddTag_Click"/>
                    </Grid>

                    <ItemsControl x:Name="SelectedTagsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Content="Import"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Import_Click"
                        HorizontalAlignment="Stretch"
                        MinWidth="280"/>

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        HorizontalAlignment="Stretch"
                        MinWidth="280"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
