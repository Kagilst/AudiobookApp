<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AudiobookApp.Views.DirectorySeriesReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Review proposed series"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText"
                       Opacity="0.75"
                       TextWrapping="WrapWholeWords"
                       Text="Confirm series groupings, rename them, or move books between series."/>
        </StackPanel>

        <ListView x:Name="SeriesList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,0,0,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         Header="Series name"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ReasonLabel}"
                                           Opacity="0.65"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ListView ItemsSource="{Binding BookRows}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      MinWidth="32"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Author}" Opacity="0.65" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Remove series"
                                        Click="RemoveSeries_Click"
                                        Tag="{Binding}"/>
                                <Button Content="Remove selected books"
                                        Click="RemoveSelectedBooks_Click"
                                        Tag="{Binding}"/>
                                <Button Content="Add book..."
                                        Click="AddBookToSeries_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Content="Skip series"
                    Click="Skip_Click"
                    MinWidth="120"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="110"/>
            <Button Grid.Column="2"
                    Content="Continue"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Continue_Click"
                    MinWidth="120"/>
        </Grid>
    </Grid>
</Page>
