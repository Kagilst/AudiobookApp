<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AudiobookApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AudiobookApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Whiter light theme; pane + page share the same solid white surface. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}"/>

                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AppSurfaceColor}"/>
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppSurfaceColor}"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F5F5F5"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>

                    <!-- NavigationView left pane is transparent by default; force white so it themes with the app. -->
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppSurfaceColor}"/>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource AppSurfaceColor}"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource AppSurfaceColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
